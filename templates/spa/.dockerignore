# What must never reach the image (keys!) or only slows the build down.
# dockerignore patterns match from the project root: `**/` makes them match at any depth.
.git
.appext
keys
**/*.pem
**/*.key
**/.env
auth-bundle
.venv
**/__pycache__
**/.pytest_cache
**/node_modules
frontend/dist
tests
compose.yaml
README.md
